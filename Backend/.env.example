# Optional keys for Art Studio's NYC events. Copy this file to .env and fill in
# the ones you have; the site works without them.

# SerpApi (https://serpapi.com) — Google Events search for one-off art events.
# Free plan: 250 searches a month; the site uses 3 searches a day (~90 a month).
SERPAPI_KEY=

# Firecrawl (https://firecrawl.dev) — reads gallery sites that build their
# pages in the browser (currently Gladstone). Used once every 6 hours.
FIRECRAWL_API_KEY=

# Google Gemini (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Supabase accounts (sign-in page; piece lookups, cart and White Board need an account).
# Both the server and the website build read these. Use the PUBLISHABLE key only,
# never the secret / service_role key.
SUPABASE_URL=https://xbvnyixlszfrjugqodtt.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_hq3ULNVmOCnvZKTdI2LSOQ_3a6_-Kle
